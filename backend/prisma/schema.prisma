generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Customer {
  id    Int     @id @default(autoincrement())
  name  String
  zone  String?

  forecasts Forecast[]
  sales Sale[]
}

model Product {
  id       Int     @id @default(autoincrement())
  name     String
  category String?
  price    Decimal @db.Decimal(12, 2)
  stock    Int     @default(0)
  leadTimeDays Int @default(30)
  forecasts Forecast[]
  sales Sale[]
}

model Sale {
  id         Int      @id @default(autoincrement())
  customerId Int
  productId  Int
  date       DateTime
  quantity   Int
  unitPrice  Decimal  @db.Decimal(12, 2)

  customer Customer @relation(fields: [customerId], references: [id])
  product  Product  @relation(fields: [productId], references: [id])

  @@index([customerId, productId, date])
}

model Forecast {
  id         Int      @id @default(autoincrement())
  customerId Int
  productId  Int
  date       DateTime
  prediction Int
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id])
  product  Product  @relation(fields: [productId], references: [id])

  @@unique([customerId, productId, date])
}
